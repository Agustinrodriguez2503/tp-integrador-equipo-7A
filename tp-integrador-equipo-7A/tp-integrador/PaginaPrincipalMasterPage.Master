<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="PaginaPrincipalMasterPage.master.cs" Inherits="tp_integrador.PaginaPrincipalMasterPage" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title></title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-4Q6Gf2aSP4eDXB8Miphtr37CMZZQ5oXLH2yaXMJ2w8e2ZtHTl7GptT4jmndRuHDT" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js" integrity="sha384-j1CDi7MgGQ12Z7Qab0qlWQ/Qqz24Gc6BM0thvEMVjHnfYGF0rmFCozFSxQBxwHKO" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
    <form id="form1" runat="server">
        <div class="container-fluid">
            <nav class="navbar navbar-expand-sm navbar-dark bg-dark py-3">
                <div class="container-fluid px-4">
                    <!-- Logo y menú -->
                    <div class="d-flex align-items-center">
                        <!-- Logo -->
                        <a class="navbar-brand me-4" href="#">
                            <img src="/images/logo_veterinaria.png" alt="Logo" width="70" height="70" class="d-inline-block align-text-top">
                        </a>

                        <!-- Enlaces -->
                        <div class="collapse navbar-collapse" runat="server" id="contenedorInicio">
                            <ul class="navbar-nav gap-3">
                                <li class="nav-item">
                                    <a class="nav-link fs-5 text-white" runat="server" href="PaginaPrincipal">Inicio</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link fs-5 text-white" runat="server" href="#Nosotros" id="acercaDe">Acerca de</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link fs-5 text-white" runat="server" href="#Contacto" id="contacto">Contacto</a>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <!-- Login -->
                    <div id="contenedorLogin" runat="server" class="d-flex align-items-center text-nowrap">
                        <img src="/images/logo_sesion.png" alt="User Icon" width="32" height="32" class="me-2">
                        <a href="IniciarSesion" class="text-white text-decoration-none fs-6 fw-semibold">Iniciar sesión</a>
                    </div>
                </div>
            </nav>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>
    </form>
</body>
</html>
