<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="RecepcionistaMasterPage.master.cs" Inherits="tp_integrador.RecepcionistaMasterPage" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title></title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-4Q6Gf2aSP4eDXB8Miphtr37CMZZQ5oXLH2yaXMJ2w8e2ZtHTl7GptT4jmndRuHDT" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js" integrity="sha384-j1CDi7MgGQ12Z7Qab0qlWQ/Qqz24Gc6BM0thvEMVjHnfYGF0rmFCozFSxQBxwHKO" crossorigin="anonymous"></script>
    <link href="~/Styles/EstilosPropios.css" rel="stylesheet" runat="server" />

</head>
<body>
    <form id="form1" runat="server">
        <div class="container-fluid">
            <nav class="navbar navbar-expand-sm navbar-dark bg-dark py-3">
                <div class="container-fluid px-4">
                    <!-- Logo y menú -->
                    <div class="d-flex align-items-center">
                        <!-- Logo -->
                        <a class="navbar-brand me-4" href="#">
                            <img src="/images/logo_veterinaria.png" alt="Logo" width="70" height="70" class="d-inline-block align-text-top">
                        </a>
                    </div>

                    <!-- Cerrar Sesion -->
                    <div id="contenedorLogin" runat="server" class="d-flex align-items-center text-nowrap">
                        <asp:Button ID="btnCerrarSesion" runat="server" Text="Cerrar Sesión"
                            CssClass="btn btn-outline-light btn-sm fw-semibold px-3 py-2 rounded-pill" OnClick="btnCerrarSesion_Click" />
                    </div>
                    <!-- Return -->
                    <div id="contenedorReturn" runat="server" class="d-flex align-items-center text-nowrap">
                        <asp:Button ID="btnReturn" runat="server" Text="Volver"
                            CssClass="btn btn-outline-light btn-sm fw-semibold px-3 py-2 rounded-pill" OnClick="btnReturn_Click" />
                    </div>
                </div>
            </nav>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>
    </form>
</body>
</html>
